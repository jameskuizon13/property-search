# Defaults work with `make services` (Postgres + Redis in Docker on localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
# JWT_SECRET=  # at least 32 bytes (bin/rails secret); unset = derived from secret_key_base
# Comma-separated IPs/CIDRs of load balancers in front of the API. Only their
# X-Forwarded-For is believed when keying rate limits; empty = trust nobody.
# TRUSTED_PROXIES=10.0.0.0/8

# Optional: the deploy revision, mixed into search ETags so a new release never
# answers 304 with bodies cached under the old code. Unset by default; then
# only PropertiesController::ETAG_SCHEMA (bumped by hand) does that job.
# GIT_SHA=
