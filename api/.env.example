# Defaults work with `make services` (Postgres + Redis in Docker on localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
# JWT_SECRET=  # falls back to Rails.application.secret_key_base
# Comma-separated IPs/CIDRs of load balancers in front of the API. Only their
# X-Forwarded-For is believed when keying rate limits; empty = trust nobody.
# TRUSTED_PROXIES=10.0.0.0/8
