# Build only the packages (api/, web/) that the pushed commits change.
# Skip once with `git push --no-verify`.
#
# git passes one line per ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# Note: the builds run on the working tree, so commit or stash first if it
# has changes you are not pushing.

changed=""

# git sends an all-zeros sha for a ref that does not exist on one side.
is_zero() { case $1 in *[!0]*) return 1 ;; *) return 0 ;; esac; }
build_all=false

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch (local sha is all zeros): nothing to build.
  is_zero "$local_sha" && continue

  if ! is_zero "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # Updating a branch we know: only the commits the remote lacks.
    base=$remote_sha
  else
    # New branch (or a remote commit we never fetched): compare with main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  fi

  if [ -z "$base" ]; then
    build_all=true
  else
    changed="$changed
$(git diff --name-only --no-renames "$base" "$local_sha")"
  fi
done

touches() {
  [ "$build_all" = true ] || printf '%s\n' "$changed" | grep -q "^$1/"
}

if touches api; then
  echo "pre-push: api changed, eager-loading the app (bin/rails zeitwerk:check)"
  (cd api && bin/rails zeitwerk:check)
fi

if touches web; then
  echo "pre-push: web changed, building (pnpm build)"
  (cd web && pnpm build)
fi
